# Server config for the static export, served by LiteSpeed on hosting.com
# shared hosting (reads Apache .htaccess). Copied into out/ by next build.
# The redirects that used to live in next.config.ts are here. See DEPLOY.md.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS and the canonical host in one hop. AutoSSL needs /.well-known/
  # reachable over plain HTTP, so it's left alone.
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^charlesndirangu\.com$ [NC]
  RewriteRule ^ https://charlesndirangu.com%{REQUEST_URI} [R=301,L]

  # / goes to the English home. There is no root page; every page lives
  # under /en/ or /sw/.
  RewriteRule ^$ /en/ [R=301,L]

  # Workbench redesign: four pages (/, /work/, /about/, /contact/) per
  # locale. One explicit 301 per old route, in one hop. No catch-all, and no
  # rule matches a new path (/xx/, /xx/work/, /xx/about/, /xx/contact/), so
  # nothing can loop.

  # Old flat paths, from before the locale prefix.
  RewriteRule ^work/?$ /en/work/ [R=301,L]
  RewriteRule ^about/?$ /en/about/ [R=301,L]
  RewriteRule ^contact/?$ /en/contact/ [R=301,L]
  RewriteRule ^projects/?$ /en/work/ [R=301,L]
  RewriteRule ^projects/[^/]+/?$ /en/work/ [R=301,L]
  RewriteRule ^capabilities/?$ /en/work/ [R=301,L]
  RewriteRule ^technologies/?$ /en/work/ [R=301,L]
  RewriteRule ^philosophy/?$ /en/ [R=301,L]
  RewriteRule ^writing/?$ /en/ [R=301,L]
  RewriteRule ^writing/[^/]+/?$ /en/ [R=301,L]
  RewriteRule ^experience/?$ /en/about/ [R=301,L]
  RewriteRule ^resume/?$ /en/about/ [R=301,L]

  # Removed pages, in each locale ($1 is en or sw).
  RewriteRule ^(en|sw)/projects/?$ /$1/work/ [R=301,L]
  RewriteRule ^(en|sw)/projects/[^/]+/?$ /$1/work/ [R=301,L]
  RewriteRule ^(en|sw)/capabilities/?$ /$1/work/ [R=301,L]
  RewriteRule ^(en|sw)/technologies/?$ /$1/work/ [R=301,L]
  RewriteRule ^(en|sw)/philosophy/?$ /$1/ [R=301,L]
  RewriteRule ^(en|sw)/writing/?$ /$1/ [R=301,L]
  RewriteRule ^(en|sw)/writing/[^/]+/?$ /$1/ [R=301,L]
  RewriteRule ^(en|sw)/experience/?$ /$1/about/ [R=301,L]
  RewriteRule ^(en|sw)/resume/?$ /$1/about/ [R=301,L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/avif .avif
  AddType video/mp4 .mp4
  AddType video/webm .webm
  AddType font/woff2 .woff2
</IfModule>

# The OG images export as en/opengraph-image and sw/opengraph-image, with no
# extension. They are PNGs; without this, nosniff makes crawlers reject them.
<FilesMatch "^opengraph-image$">
  ForceType image/png
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Pages and RSC payloads change on every build.
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Hashed build assets never change under the same name.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "(\.(png|jpe?g|webp|avif|gif|svg|ico|mp4|webm)|^opengraph-image)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
