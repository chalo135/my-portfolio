# Server config for the static export, served by LiteSpeed on hosting.com
# shared hosting (reads Apache .htaccess). Copied into out/ by next build.
# The redirects that used to live in next.config.ts are here. See DEPLOY.md.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Every redirect below names the full https://charlesndirangu.com target and
  # sits above the HTTPS and host rule, so an old link reaches its page in one
  # hop whatever scheme or host it arrived on. None of these patterns matches
  # a live path (/en/..., /sw/..., /_next/, /cv/, /me/, /icons/, /work/ files)
  # or /.well-known/, so nothing can loop.

  # / goes to the English home. There is no root page; every page lives
  # under /en/ or /sw/.
  RewriteRule ^$ https://charlesndirangu.com/en/ [R=301,L]

  # Workbench redesign: four pages (/, /work/, /about/, /contact/) per
  # locale. One explicit 301 per old route. No catch-all.

  # Old flat paths, from before the locale prefix.
  RewriteRule ^work/?$ https://charlesndirangu.com/en/work/ [R=301,L]
  RewriteRule ^about/?$ https://charlesndirangu.com/en/about/ [R=301,L]
  RewriteRule ^contact/?$ https://charlesndirangu.com/en/contact/ [R=301,L]
  RewriteRule ^projects/?$ https://charlesndirangu.com/en/work/ [R=301,L]
  RewriteRule ^projects/[^/]+/?$ https://charlesndirangu.com/en/work/ [R=301,L]
  RewriteRule ^capabilities/?$ https://charlesndirangu.com/en/work/ [R=301,L]
  RewriteRule ^technologies/?$ https://charlesndirangu.com/en/work/ [R=301,L]
  RewriteRule ^philosophy/?$ https://charlesndirangu.com/en/ [R=301,L]
  RewriteRule ^writing/?$ https://charlesndirangu.com/en/ [R=301,L]
  RewriteRule ^writing/[^/]+/?$ https://charlesndirangu.com/en/ [R=301,L]
  RewriteRule ^experience/?$ https://charlesndirangu.com/en/about/ [R=301,L]
  RewriteRule ^resume/?$ https://charlesndirangu.com/en/about/ [R=301,L]

  # Removed pages, in each locale ($1 is en or sw).
  RewriteRule ^(en|sw)/projects/?$ https://charlesndirangu.com/$1/work/ [R=301,L]
  RewriteRule ^(en|sw)/projects/[^/]+/?$ https://charlesndirangu.com/$1/work/ [R=301,L]
  RewriteRule ^(en|sw)/capabilities/?$ https://charlesndirangu.com/$1/work/ [R=301,L]
  RewriteRule ^(en|sw)/technologies/?$ https://charlesndirangu.com/$1/work/ [R=301,L]
  RewriteRule ^(en|sw)/philosophy/?$ https://charlesndirangu.com/$1/ [R=301,L]
  RewriteRule ^(en|sw)/writing/?$ https://charlesndirangu.com/$1/ [R=301,L]
  RewriteRule ^(en|sw)/writing/[^/]+/?$ https://charlesndirangu.com/$1/ [R=301,L]
  RewriteRule ^(en|sw)/experience/?$ https://charlesndirangu.com/$1/about/ [R=301,L]
  RewriteRule ^(en|sw)/resume/?$ https://charlesndirangu.com/$1/about/ [R=301,L]

  # The old site's favicon, still in some bookmarks.
  RewriteRule ^favicon\.svg$ https://charlesndirangu.com/icon.svg [R=301,L]

  # A page asked for without its trailing slash (/en/about). Done here rather
  # than left to the server default so it is one hop to the https URL.
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ https://charlesndirangu.com/$1/ [R=301,L]

  # HTTPS and the canonical host in one hop. AutoSSL needs /.well-known/
  # reachable over plain HTTP, so it's left alone.
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^charlesndirangu\.com$ [NC]
  RewriteRule ^ https://charlesndirangu.com%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/wasm .wasm
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType image/avif .avif
  AddType image/x-icon .ico
  AddType font/woff2 .woff2
  AddCharset utf-8 .html .css .js .txt .xml .svg .webmanifest
</IfModule>

# The OG images export as en/opengraph-image and sw/opengraph-image, with no
# extension. They are PNGs; without this, nosniff makes crawlers reject them.
<FilesMatch "^opengraph-image$">
  ForceType image/png
</FilesMatch>

# LiteSpeed usually compresses at the server level already. These cover a
# host where it is left to .htaccess. Fonts and images are already compressed.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE text/javascript application/javascript
  AddOutputFilterByType DEFLATE application/json application/manifest+json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml application/wasm
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS text/javascript application/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json application/manifest+json
  AddOutputFilterByType BROTLI_COMPRESS application/xml image/svg+xml application/wasm
</IfModule>

<IfModule mod_headers.c>
  # --- Security headers ---------------------------------------------------

  # Browsers that have seen the site once use HTTPS from then on (one year).
  # No includeSubDomains: this file only speaks for this one host.
  Header always set Strict-Transport-Security "max-age=31536000"
  # Files are used as the type the server says they are.
  Header always set X-Content-Type-Options "nosniff"
  # Other sites see the origin only, never the full page URL.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # No other site may show these pages in a frame.
  Header always set X-Frame-Options "DENY"
  # A tab opened from another site cannot script this one.
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Device features the site never uses are switched off.
  Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()"

  # Content-Security-Policy. Everything loads from this origin; there are no
  # third-party scripts, styles, fonts or frames. One directive per line:
  #   default-src 'self'         anything not named below: this origin only
  #   script-src                 'self' for /_next/static/ chunks;
  #                              'unsafe-inline' because Next writes the theme
  #                              script, the JSON-LD and the page data as
  #                              inline scripts whose text changes each build;
  #                              'wasm-unsafe-eval' lets the physics engine
  #                              behind the 3D card (Rapier) compile its
  #                              WebAssembly. It does not allow eval().
  #   style-src                  'self' for the CSS files; 'unsafe-inline' for
  #                              style="" attributes written by React
  #   img-src                    'self', plus data: and blob: for the 3D
  #                              card's canvas textures
  #   font-src 'self'            fonts are in /_next/static/media/
  #   connect-src                'self' for page data on navigation; data: and
  #                              blob: for the 3D loaders
  #   worker-src 'self' blob:    no worker today; allows one built from a blob
  #   manifest-src 'self'        /manifest.webmanifest
  #   object-src 'none'          no plugins
  #   base-uri 'self'            no <base> pointing elsewhere
  #   form-action 'self' mailto: the contact form opens the mail app
  #   frame-ancestors 'none'     same job as X-Frame-Options, newer browsers
  #   upgrade-insecure-requests  any http:// subresource is asked for as https
  # Links out (GitHub, LinkedIn, https://wa.me, mailto:) are navigations,
  # which this policy does not restrict.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' data: blob:; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'none'; upgrade-insecure-requests"

  # --- Cache headers --------------------------------------------------------

  # Pages, page data (.txt), robots.txt, the sitemap and the manifest change
  # with a build: always revalidate.
  <FilesMatch "\.(html|txt|xml|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Build assets under /_next/static/ have a hash in the name and never
  # change under that name. Nothing else on the site is .js, .css or .woff2.
  <FilesMatch "\.(js|css|woff2|wasm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Images in public/ keep their name when replaced, so a week, not a year.
  <FilesMatch "\.(png|jpe?g|webp|avif|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # The share card: a day, so a new one reaches crawlers quickly.
  <FilesMatch "^opengraph-image$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  # The CV is replaced under the same name: an hour.
  <FilesMatch "\.pdf$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>
